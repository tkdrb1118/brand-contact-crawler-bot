GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json
GOOGLE_OAUTH_CLIENT=credentials/oauth-client.json
GOOGLE_TOKEN_PATH=.tokens/google-oauth-token.json

# Optional. Apps Script writes jobs into this sheet.
SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/14_wDg1O9qfNaCtgQU8FJQVj_3ItCFVykMbdWXHd5Mxo/edit
SHEET_NAME=김윤아
JOBS_SHEET_NAME=_brandCrawlerJobs

# Optional. Rows matching this sales-blocklist spreadsheet are skipped.
EXCLUDE_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/1o1ji4gYXu9iPqBNZaWOBhPH8wMjlpz3jRMXWoDrnux8/edit
EXCLUDE_SHEET_NAME=영업금지리스트
EXCLUDE_HEADER_ROW=4
EXCLUDE_DATA_START_ROW=5

# Crawl defaults
CONCURRENCY=3
REQUEST_TIMEOUT_MS=12000
OVERWRITE=false
